{
  "info": {
    "name": "Feeding Brennen",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Send requests manually in the listed order. Replace example restaurant ID 6 in URLs and visit bodies with the ID returned by Create restaurant. Test duplicates before deleting the restaurant; the final three requests use its deleted ID. Status codes in names are expected results."
  },
